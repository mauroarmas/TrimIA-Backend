# Copiar a deploy/local/.env mediante scripts/demo-local.sh init.
# URL HTTPS que muestra tailscale funnel. Sin barra final.
DEMO_PUBLIC_URL=https://trimia-demo.TU-RED.ts.net
# Meta for Developers → Configuración de la app → Básica → Clave secreta de app.
# No es el token de WhatsApp. Completar solo en tu equipo, no enviarlo al chat.
META_APP_SECRET=
# El inicializador genera este valor. Usar el mismo en el verify token de Meta.
META_VERIFY_TOKEN=GENERAR_AL_INICIALIZAR
