# === Entorno ===
NODE_ENV=development
PORT=3000

# === Autenticación (JWT) ===
# Secreto para firmar/verificar el JWT de sesión de empleados y supervisores
# (POST /auth/login). Vida del token: 8 horas. Mín. 32 caracteres.
JWT_SECRET=changeme-jwt-secret-min-32-characters

# === PostgreSQL ===
POSTGRES_USER=trimia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trimia
# Para correr la app en el host contra el contenedor: host=localhost, puerto publicado 5433.
DATABASE_URL=postgresql://trimia:changeme@localhost:5433/trimia
# Pool de conexiones del checkpointer de LangGraph.
POSTGRES_SAVER_POOL_MAX=5

# === Redis (BullMQ) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Google Gemini ===
GOOGLE_API_KEY=your-google-api-key
# Pinear explícitamente el modelo (NO confiar en el default del código).
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2-preview

# === ChromaDB (RAG) ===
CHROMA_URL=http://localhost:8000

# === n8n / WhatsApp ===
# Secreto del webhook entrante de WhatsApp (mín. 32 caracteres).
N8N_WEBHOOK_SECRET=changeme-shared-secret-min-32-characters
N8N_BASE_URL=http://localhost:5678

# === /knowledge (carga y búsqueda de conocimiento, dev) ===
# Secreto PROPIO, distinto de N8N_WEBHOOK_SECRET: /knowledge/search permite
# pedir audiencia INTERNO (dump de conocimiento confidencial), así que no
# comparte llave con el webhook de WhatsApp (mín. 32 caracteres).
KNOWLEDGE_ADMIN_SECRET=changeme-knowledge-secret-min-32-chars

# === RAG ===
# Umbral de similitud por debajo del cual el agente escala a humano (0-1).
# Calibrado con gemini-embedding-001: relevantes ~0.74-0.81, irrelevantes ~0.55.
RAG_CONFIDENCE_THRESHOLD=0.65

# Umbral a partir del cual dos DOCUMENTOS se consideran parecidos, para avisar
# al cargar que ya hay algo sobre ese tema (spec 007).
#
# NO es el de arriba y no se puede heredar: aquél mide cuán bien una consulta
# corta encuentra un fragmento; éste compara dos documentos enteros, que puntúan
# mucho más alto entre sí. Medido sobre el corpus real: no-duplicados 73.1%,
# duplicados 76.3-77.6%. Margen de 3.2 puntos — recalibrar si entra un dominio
# nuevo (scripts/calibrar-parecido.ts).
KNOWLEDGE_SIMILARITY_THRESHOLD=0.75

# Higiene del corpus (spec 008): a partir de qué solapamiento se propone
# FUSIONAR dos documentos. NO es el de arriba: aquél muestra los 4 mejores de
# un documento nuevo; éste barre TODAS las parejas del corpus sin límite de
# cuántas se muestran. Medido (scripts/calibrar-fusion.ts): con 0.75 marca 141
# de 343 parejas (inservible); con 0.85 marca 10 (revisable, SC-006).
KNOWLEDGE_MERGE_THRESHOLD=0.85

# === Carga de archivos a la base de conocimiento (Sprint 5A) ===
# Techo general: lo máximo que se acepta subir, para cualquier formato.
KNOWLEDGE_MAX_FILE_MB=20
# Techo MENOR solo para imagen y audio, que se procesan con Gemini.
# No es una elección arbitraria: la API limita la petición a 20 MB TOTALES y
# base64 infla el binario ~33%, así que un archivo de 20 MB produce un request
# de ~27 MB y falla. PDF y Word se extraen localmente (unpdf/mammoth) y NO
# están sujetos a este límite — de hecho son los que más se acercan al techo
# general (un PDF escaneado de 30 páginas pesa 20-40 MB).
KNOWLEDGE_MULTIMODAL_MAX_MB=14
# Dónde se guardan los originales que SÍ se conservan (PDF, Word, imagen).
# El audio nunca se guarda: se elimina apenas se transcribe.
STORAGE_KNOWLEDGE_DIR=storage/knowledge

# === Chats del panel en tiempo real (Sprint 5B, spec 004) ===
# Cada cuánto se manda un keepalive por el stream de un chat del panel. Cumple
# tres funciones a la vez, y por eso no conviene subirlo mucho: mantiene la
# conexión viva para que ningún intermediario la corte por inactividad, es el
# reloj que revalida el permiso de un stream ya abierto (si a alguien se le
# quita el acceso, la ventana de exposición es este intervalo), y es cuando se
# detecta que el token venció.
SSE_HEARTBEAT_MS=15000
# Tras cuánta inactividad se cierra la CONEXIÓN de un chat abierto (30 min por
# defecto). Cierra la conexión, NO la conversación: al volver a escribir se sigue
# en el mismo hilo, con el mismo contexto. Cerrarla no pierde ningún mensaje —
# la base es la fuente de verdad y el panel reanuda desde el último que vio.
# Si el asistente está trabajando en una respuesta, no se cierra.
SSE_IDLE_TIMEOUT_MS=1800000

# === Spec 009 — qué falta para responder mejor ===
# Ventana por defecto del resumen de cobertura, pisable por parámetro.
COVERAGE_WINDOW_DAYS=30
# Turnos POR AGENTE para publicar cobertura en el panel (US2). Distinto de
# COVERAGE_SCAN_MIN_QUERIES: cuentan poblaciones distintas — éste es de un
# agente a la vez, el otro es de los cinco juntos.
COVERAGE_MIN_SAMPLE=10
# Consultas de LOS CINCO AGENTES JUNTOS en la ventana para correr y mostrar
# temas (US1). Arranca en el mismo valor que COVERAGE_MIN_SAMPLE por
# coincidencia, no porque sea la misma cosa.
COVERAGE_SCAN_MIN_QUERIES=10
# Piso de ruido medido en la spec 006 (specs/006-calidad-busqueda-rag/research.md).
COVERAGE_NOISE_FLOOR=54.3
# Puntos sobre RAG_CONFIDENCE_THRESHOLD que se consideran "contestada al
# límite" (US3) — el aviso más temprano posible, antes de que escale.
COVERAGE_MARGINAL_BAND=5
# Mínimo de consultas para que un grupo se reporte como tema.
COVERAGE_MIN_QUERIES_PER_THEME=2
# Tope de consultas por corrida, las más recientes de la ventana.
COVERAGE_MAX_QUERIES_PER_SCAN=300
# Solape de consultas para reconocer el mismo tema entre corridas (0-1): el
# nombre del tema puede cambiar, el conjunto de consultas que lo forman no.
COVERAGE_THEME_OVERLAP=0.5
# Citas textuales por tema en el resumen.
COVERAGE_MAX_QUOTES_PER_THEME=3

# === Números de prueba cargados en Meta (solo desarrollo) ===
# En desarrollo cada número tiene una identidad fija: el resto de los
# empleados entra por el portal web con las credenciales del seed.
#   DEV_CLIENT_PHONE    → el cliente; a él se le cuelga la venta financiada
#                         de ejemplo del seed y sobre él actúa
#                         POST /dev/client-fixtures.
#   DEV_COLLECTOR_PHONE → el cobrador (Roberto Sosa); recibe por WhatsApp la
#                         notificación de un pago que no impactó (US3).
# Formato argentino: 549 + área sin 0 + número sin 15.
DEV_CLIENT_PHONE=5491133334444
DEV_COLLECTOR_PHONE=5491100002222
