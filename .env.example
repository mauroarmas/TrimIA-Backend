# === Entorno ===
NODE_ENV=development
PORT=3000

# === PostgreSQL ===
POSTGRES_USER=trimia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trimia
# Para correr la app en el host contra el contenedor: host=localhost, puerto publicado 5433.
DATABASE_URL=postgresql://trimia:changeme@localhost:5433/trimia
# Pool de conexiones del checkpointer de LangGraph.
POSTGRES_SAVER_POOL_MAX=5

# === Redis (BullMQ) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Google Gemini ===
GOOGLE_API_KEY=your-google-api-key
# Pinear explícitamente el modelo (NO confiar en el default del código).
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# === ChromaDB (RAG) ===
CHROMA_URL=http://localhost:8000

# === n8n / WhatsApp ===
# Secreto compartido para el webhook entrante y la carga de conocimiento.
N8N_WEBHOOK_SECRET=changeme-shared-secret
N8N_BASE_URL=http://localhost:5678

# === RAG ===
# Umbral de similitud por debajo del cual el agente escala a humano (0-1).
# Calibrado con gemini-embedding-001: relevantes ~0.74-0.81, irrelevantes ~0.55.
RAG_CONFIDENCE_THRESHOLD=0.65

# === Números de prueba cargados en Meta (solo desarrollo) ===
# En desarrollo cada número tiene una identidad fija: el resto de los
# empleados entra por el portal web con las credenciales del seed.
#   DEV_CLIENT_PHONE    → el cliente; a él se le cuelga la venta financiada
#                         de ejemplo del seed y sobre él actúa
#                         POST /dev/client-fixtures.
#   DEV_COLLECTOR_PHONE → el cobrador (Roberto Sosa); recibe por WhatsApp la
#                         notificación de un pago que no impactó (US3).
# Formato argentino: 549 + área sin 0 + número sin 15.
DEV_CLIENT_PHONE=5491133334444
DEV_COLLECTOR_PHONE=5491100002222
