{
  "name": "CRM: Búsqueda de Prospecto por Teléfono",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "crm-prospect-search",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -512,
        112
      ],
      "id": "webhook-crm-prospect-search",
      "name": "Webhook Prospect Search",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURAR_AUTH",
          "name": "TrimIA x-n8n-secret"
        }
      }
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "CONFIGURAR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "CRM",
          "mode": "name"
        },
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Teléfono",
              "lookupValue": "={{ $json.query.phone }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -256,
        112
      ],
      "id": "sheets-crm-prospect-search",
      "name": "Google Sheets Read",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CONFIGURAR_GOOGLE",
          "name": "Google Sheets CRM"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => { const row = $input.all().map(i => i.json).find(r => String(r['Teléfono']) === String($('Webhook Prospect Search').first().json.query.phone)); return { found: !!row, prospect: row || null }; })() }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        0,
        112
      ],
      "id": "respond-crm-prospect-search",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook Prospect Search": {
      "main": [
        [
          {
            "node": "Google Sheets Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets Read": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false
}
