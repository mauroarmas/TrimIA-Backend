{
  "name": "Recepción de Mensaje (A)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Formato directo (Postman/WEB): { phone, message }\nif (body?.phone && body?.message) {\n  return [{ json: { phone: body.phone, message: body.message, channel: 'WEB', isImage: 'false' } }];\n}\n\n// Formato real de WhatsApp Business API\nconst message = body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\nif (!message) return [];\n\nif (message.type === 'text') {\n  return [{ json: { phone: message.from, message: message.text.body, channel: 'WHATSAPP', isImage: 'false' } }];\n}\n\n// Comprobante de pago (Sprint 4): acá solo extraemos el mediaId/mimeType.\n// La resolución+descarga contra la Graph API de Meta la hacen los nodos\n// HTTP Request de abajo — el Code Node de n8n (Task Runner) NO soporta\n// this.helpers.httpRequestWithAuthentication (confirmado en vivo, n8n 2.30.7).\nif (message.type === 'image') {\n  return [{\n    json: {\n      phone: message.from,\n      message: message.image.caption ?? '',\n      channel: 'WHATSAPP',\n      isImage: 'true',\n      mediaId: message.image.id,\n      mimeType: message.image.mime_type,\n    },\n  }];\n}\n\n// Otros tipos (audio, video, documento, sticker...) quedan fuera de alcance.\nreturn [];\n"
      },
      "type": "n8n-nodes-base.code",
