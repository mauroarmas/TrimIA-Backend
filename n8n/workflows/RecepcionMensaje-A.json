        -320
      ],
      "id": "c5d6e7f8-5555-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Preparar audio para Gemini"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GOOGLE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [\n    { text: 'Transcribí literalmente lo que se dice en este audio, en español rioplatense. No agregues nada que no se haya dicho. Si el audio está en silencio, no se entiende, o no contiene lenguaje hablado, respondé exactamente SIN_CONTENIDO y nada más.' },\n    { inline_data: { mime_type: $json.mimeType, data: $json.audioBase64 } }\n  ] }]\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
        -320
      ],
      "id": "d6e7f8a9-6666-4b2c-8d3e-4f5a6b7c8d9e",
      "name": "Transcribir audio (Gemini)"
    },
    {
      "parameters": {
        "jsCode": "// Contrato con el backend (FR-009): si no hay transcripción usable, se manda\n// un marcador y el orquestador responde pidiendo reformulación SIN llamar al\n// LLM ni escalar a una persona. El literal tiene que coincidir exactamente con\n// UNTRANSCRIBABLE_AUDIO_MARKER de src/ai/orchestrator/utils/trivial-filter.ts.\nconst MARKER = '__AUDIO_NO_TRANSCRIBIBLE__';\n\nconst original = $('Code in JavaScript').item.json;\nconst res = $input.first().json;\n\n// neverError:true en el nodo HTTP → un 4xx/5xx de Gemini llega acá como body,\n// no como excepción. Se trata igual que \"no se entendió\": el usuario recibe un\n// pedido de reformulación en vez de quedarse sin respuesta.\nconst text = res?.candidates?.[0]?.content?.parts?.[0]?.text?.trim() ?? '';\n\nconst usable = text && !text.includes('SIN_CONTENIDO');\n\nreturn [{\n  json: {\n    phone: original.phone,\n    message: usable ? text : MARKER,\n    channel: original.channel,\n    // Sin mediaBase64/mimeType a propósito: el backend recibe TEXTO.\n    // El binario del audio muere acá (FR-011) — no se guarda en ningún lado.\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
