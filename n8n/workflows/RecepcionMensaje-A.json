    {
      "parameters": {
        "jsCode": "// getBinaryDataBuffer resuelve el binario sin importar el modo de\n// almacenamiento de n8n (memoria/filesystem/S3) — leer item.binary.data.data\n// directo solo funciona en modo memoria (mismo bug que documenta\n// \"Armar payload final\").\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst original = $('Code in JavaScript').item.json;\n\nreturn [{\n  json: {\n    phone: original.phone,\n    channel: original.channel,\n    mimeType: original.mimeType || 'audio/ogg',\n    audioBase64: buffer.toString('base64'),\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
