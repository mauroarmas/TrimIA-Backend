{
  "name": "Recepción de Mensaje (A)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Formato directo (Postman/WEB): { phone, message }\nif (body?.phone && body?.message) {\n  return [{ json: { phone: body.phone, message: body.message, channel: 'WEB', mediaKind: '' } }];\n}\n\n// Formato real de WhatsApp Business API\nconst message = body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\nif (!message) return [];\n\nif (message.type === 'text') {\n  return [{ json: { phone: message.from, message: message.text.body, channel: 'WHATSAPP', mediaKind: '' } }];\n}\n\n// Comprobante de pago (Sprint 4): acá solo extraemos el mediaId/mimeType.\n// La resolución+descarga contra la Graph API de Meta la hacen los nodos\n// HTTP Request de abajo — el Code Node de n8n (Task Runner) NO soporta\n// this.helpers.httpRequestWithAuthentication (confirmado en vivo, n8n 2.30.7).\nif (message.type === 'image') {\n  return [{\n    json: {\n      phone: message.from,\n      message: message.image.caption ?? '',\n      channel: 'WHATSAPP',\n      mediaKind: 'image',\n      mediaId: message.image.id,\n      mimeType: message.image.mime_type,\n    },\n  }];\n}\n\n// Nota de voz (Sprint 5A, US5 / RF-14). Se baja igual que la imagen —mismos\n// dos nodos HTTP— y recién después se bifurca para transcribir.\n// WhatsApp manda las notas de voz como audio/ogg (codec Opus), que Gemini\n// acepta; el mime_type real viaja igual por si Meta cambia el contenedor.\nif (message.type === 'audio') {\n  return [{\n    json: {\n      phone: message.from,\n      message: '',\n      channel: 'WHATSAPP',\n      mediaKind: 'audio',\n      mediaId: message.audio.id,\n      mimeType: message.audio.mime_type,\n    },\n  }];\n}\n\n// Otros tipos (video, documento, sticker...) quedan fuera de alcance.\nreturn [];\n"
      },
