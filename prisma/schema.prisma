generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  WHATSAPP
  WEB
}

enum ConvStatus {
  ACTIVE
  WAITING_HUMAN
  HUMAN_HANDLING // supervisor tomó control del chat (Sprint 3)
  CLOSED
}

enum AgentType {
  ORCHESTRATOR
  SALES
  COLLECTIONS
  LOGISTICS
  DEPOSITS
  ADMIN
}

enum EmployeeRole {
  EMPLEADO
  SUPERVISOR
}

// Sector de la empresa. Gatea qué módulos del panel ve cada empleado.
model Sector {
  id        String     @id @default(uuid())
  name      String     @unique // Ventas, Cobranzas, Administración, Logística, Depósito
  agentType AgentType? // agente principal asociado al sector (para queries)
  createdAt DateTime   @default(now())

  employees Employee[]
}

// Empleado/supervisor autorizado. Determina userType al recibir un mensaje.
model Employee {
  id        String       @id @default(uuid())
  phone     String       @unique // número WhatsApp normalizado
  email     String       @unique
  name      String
  password  String       // hash bcrypt
  role      EmployeeRole @default(EMPLEADO)
  isActive  Boolean      @default(true)
  sectorId  String
  sector    Sector       @relation(fields: [sectorId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([phone])
  @@index([email])
  @@index([sectorId])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

// Audiencia del conocimiento: filtra qué puede recuperar el RAG según quién pregunta.
enum Audience {
  PUBLICO // accesible por clientes y empleados
  INTERNO // solo empleados
}

// Tipo de usuario que interactúa: define audiencia y agentes habilitados.
enum UserType {
  CLIENTE // externo → solo conocimiento PUBLICO, agentes SALES/COLLECTIONS
  EMPLEADO // interno → conocimiento PUBLICO + INTERNO, los 5 agentes
}

model Conversation {
  id         String     @id @default(uuid())
  channel    Channel
  externalId String
  status        ConvStatus @default(ACTIVE)
  currentAgent  AgentType? // agente "sticky" que atiende la conversación (null = sin asignar)
  agentLockedAt DateTime? // cuándo se fijó el currentAgent
  userType      UserType   @default(CLIENTE) // determina audiencia e intents permitidas
  createdAt     DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  messages   Message[]
  tokenUsage TokenUsage[]
  events     OrchestrationEvent[]

  @@index([externalId])
  @@index([status])
  @@index([createdAt])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MessageRole
  content        String
  agentType      AgentType?
  createdAt      DateTime    @default(now())

  @@index([conversationId, createdAt])
}

// NOTA: el checkpointer de LangGraph (interrupt/resume) está desactivado. Cuando se
// reactive en Fase 5 (flujo de venta financiada / human-in-the-loop), su PostgresSaver
// recrea solo sus tablas (checkpoints, checkpoint_writes, checkpoint_blobs,
// checkpoint_migrations) vía .setup(). No las gestiona Prisma. Usará conversationId
// como thread_id.

model TokenUsage {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  agentType      AgentType
  inputTokens    Int
  outputTokens   Int
  durationMs     Int
  model          String
  createdAt      DateTime      @default(now())

  @@index([agentType, createdAt])
}

model KnowledgeDocument {
  id        String     @id @default(uuid())
  title     String
  content   String
  category  String
  audience  Audience   @default(INTERNO) // público/interno para filtrar el RAG
  agentType AgentType? // agente dueño del doc (null = general, para todos)
  vectorId  String?
  version   Int        @default(1)
  checksum  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([category])
  @@index([category, version])
  @@index([audience])
}

model OrchestrationEvent {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  eventType      String
  agentType      AgentType?
  payload        Json
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([eventType])
  @@index([createdAt])
}